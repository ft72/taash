{
  "name": "taash",
  "version": "0.1.0",
  "private": true,
  "description": "Taash — traditional card games with friends. First game: Thulla.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.js",
    "db:studio": "drizzle-kit studio",
    "test": "cross-env LOG_LEVEL=warn node --test --test-reporter=spec \"tests/unit/**/*.test.js\"",
    "test:integration": "cross-env LOG_LEVEL=warn node --test --test-concurrency=1 --test-reporter=spec \"tests/integration/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:integration && npm run test:e2e",
    "soak": "cross-env LOG_LEVEL=warn node --expose-gc scripts/soak.js"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@node-rs/argon2": "^2.2.2",
    "cross-env": "^10.1.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^7.0.13",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "drizzle-kit": "^0.31.11"
  }
}
