# ---- Required in production ---------------------------------------------
# Public URL of the site. Used for auth callbacks, share links and cookies.
APP_URL=http://localhost:3000
# Auth.js reads AUTH_URL; keep it equal to APP_URL.
AUTH_URL=http://localhost:3000
# Long random string (32+ bytes). Signs sessions and guest cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# PostgreSQL connection string.
DATABASE_URL=postgres://taash:taash@localhost:5432/taash

# ---- Optional -----------------------------------------------------------
# Trust X-Forwarded-* headers from the reverse proxy (Coolify/Traefik). Keep true behind a proxy.
AUTH_TRUST_HOST=true
PORT=3000
# Max PostgreSQL connections in the pool (small home server: 5–10).
DB_POOL_MAX=8
# debug | info | warn | error
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# ---- Email (forgot password) ----------------------------------------------
# Brevo is used first; Gmail (nodemailer) is the fallback if Brevo is missing or fails.
# In development with neither set, emails are printed to the server console instead.
# Brevo: API key from Brevo → SMTP & API → API keys. MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Taash
# Gmail fallback: the account address and a Google app password
# (Google Account → Security → 2-Step Verification → App passwords). Spaces are ignored.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- Native app link verification ---------------------------------------
# Apple Team ID + bundle ID, e.g. TEAMID.com.nezden.taash
IOS_APP_ID=
# Comma-separated SHA-256 fingerprints of Android release signing certificates.
ANDROID_CERT_SHA256=
ANDROID_APP_PACKAGE=com.nezden.taash
# Optional origins for a separately hosted React Native web preview.
MOBILE_WEB_ORIGINS=

# ---- Native app -----------------------------------------------------------
# Push notifications go through Expo's push service. Set to "off" to disable.
PUSH_NOTIFICATIONS=on
# Optional: only needed if "enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=
# Optional: oldest app version the API supports (reported by GET /api/mobile/config).
MOBILE_MIN_VERSION=
